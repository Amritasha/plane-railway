# ── Database ──────────────────────────────────────────────────────────────────
# Add the Railway Postgres plugin; it auto-sets DATABASE_URL.
DATABASE_URL=postgresql://user:pass@host:5432/plane

# ── Redis ─────────────────────────────────────────────────────────────────────
# Add the Railway Redis plugin; it auto-sets REDIS_URL.
REDIS_URL=redis://host:6379

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_50_char_random_string
DJANGO_SETTINGS_MODULE=plane.settings.production

# ── URLs (set after Railway assigns domains) ──────────────────────────────────
WEB_URL=https://plane-web.up.railway.app
CORS_ALLOWED_ORIGINS=https://plane-web.up.railway.app

# ── File Storage ─────────────────────────────────────────────────────────────
# Option A: S3-compatible (recommended for production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=plane-uploads
# AWS_S3_REGION=ap-south-1

# Option B: local volume (dev/test only — data lost on redeploy)
USE_MINIO=0

# ── Mail (optional) ───────────────────────────────────────────────────────────
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=secret
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@example.com
